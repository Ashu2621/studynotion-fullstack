# Copy to Server/.env and fill in. Never commit the real file.
PORT=4000

# MongoDB connection string (for example from MongoDB Atlas)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studynotion

# Long random string used to sign login tokens
JWT_SECRET=change-me

# Where the password-reset link points and which browser origins may call the API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# SMTP account used for OTP and notification emails
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASS=

# Cloudinary (image and video uploads)
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=StudyNotion

# Razorpay (use test keys while developing)
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Only for `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
